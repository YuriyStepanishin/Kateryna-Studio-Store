{
  "name": "omee-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=.env src/utils/migrate.js",
    "admin:promote": "node --env-file-if-exists=.env src/utils/promoteAdmin.js",
    "cloudinary:check": "node --env-file-if-exists=.env src/utils/checkCloudinary.js",
    "cloudinary:migrate": "node --env-file-if-exists=.env src/utils/migrateCloudinaryImages.js",
    "cloudinary:organize": "node --env-file-if-exists=.env src/utils/organizeCloudinaryImages.js",
    "cloudinary:repair": "node --env-file-if-exists=.env src/utils/repairCloudinaryImages.js",
    "catalog:groups": "node --env-file-if-exists=.env src/utils/syncProductGroups.js",
    "cloudinary:quality": "node --env-file-if-exists=.env src/utils/improveImageQuality.js",
    "catalog:categories": "node --env-file-if-exists=.env src/utils/createCatalogCategories.js",
    "catalog:publish": "node --env-file-if-exists=.env src/utils/publishProducts.js",
    "catalog:stock": "node --env-file-if-exists=.env src/utils/setTestStock.js",
    "catalog:prepare": "node --env-file-if-exists=.env src/utils/prepareCatalog.js",
    "blog:publish": "node --env-file-if-exists=.env src/utils/publishHairArticles.js",
    "media:import": "node --env-file-if-exists=.env src/utils/importHairMedia.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^6.0.0",
    "multer": "^2.0.2",
    "cloudinary": "^2.7.0",
    "node-cron": "^4.2.0",
    "zod": "^4.1.0"
  }
}
