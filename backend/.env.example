JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Carrier directories; server only. Meest requires no key.
NOVA_POSHTA_API_KEY=
UKRPOSHTA_BEARER=
